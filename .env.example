# All values are optional; defaults shown.

# SQLite database file. The directory is created automatically.
DATABASE_PATH=.data/bangla-adventures.db

# Directory for grown-up-uploaded pronunciation audio.
MEDIA_ROOT=.data/media

# Port for `npm start`.
PORT=3000

# Migration switch. Leave as legacy for local comparison. Set to moodle in the
# pilot deployment to redirect the custom account/classroom/teacher pages to
# Moodle and return 410 from their retired API endpoints.
PLATFORM_MODE=legacy

# Moodle's public course URL. Production must use HTTPS. NEXT_PUBLIC_MOODLE_URL
# is also used by the browser UI; keep both values identical.
MOODLE_URL=
NEXT_PUBLIC_MOODLE_URL=
